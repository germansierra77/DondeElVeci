<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HISTORIAL DE VENTAS</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="../ccs/fontawesome.css">

    <!-- CSS del historial -->
    <link rel="stylesheet" href="../ccs/historialtendero.css?v=1.4">

    <!-- JavaScript principal -->
    <script type="module" src="../js/main.js?v=1.5"></script>
</head>

<body>

    <div class="contenedor">

        <!-- ========================================= -->
        <!-- ENCABEZADO -->
        <!-- ========================================= -->
        <div id="header">

            <div class="elemento">

                <span class="titulo-app">
                    APP DONDE EL VECI
                </span>
                <img src="../images/logo app.png" alt="logo" id="imagenlogo"> 

            </div>

        </div>


        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================================= -->
        <div class="contenido">


            <!-- ========================================= -->
            <!-- FILTROS -->
            <!-- ========================================= -->
            <div class="filtros">


                <!-- FECHA DESDE -->
                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="date"
                        id="fechaInicio"
                    >

                    <label for="fechaInicio">
                        Desde
                    </label>

                </div>


                <!-- FECHA HASTA -->
                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="date"
                        id="fechaFin"
                    >

                    <label for="fechaFin">
                        Hasta
                    </label>

                </div>


                <!-- ID DEL USUARIO / CLIENTE -->
                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="text"
                        id="buscarUsuario"
                        placeholder="ID Usuario"
                    >

                    <label for="buscarUsuario">
                        ID Usuario
                    </label>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- LISTADO DE VENTAS -->
            <!-- ========================================= -->
            <div class="listado">

                <table>

                    <!-- CABECERA -->
                    <thead>

                        <tr>
                            <th>FECHA</th>
                            <th>ID USUARIO</th>
                            <th>ESTADO</th>
                            <th>REVISAR</th>
                        </tr>

                    </thead>


                    <!--
                        Las ventas se cargarán aquí
                        automáticamente desde JavaScript.
                    -->
                    <tbody id="tablaVentas">

                        <tr id="filaCargando">

                            <td colspan="4">
                                Cargando historial de ventas...
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- ========================================= -->
        <!-- BOTONES INFERIORES -->
        <!-- ========================================= -->
        <div class="footer">


            <!-- BOTÓN VOLVER -->
            <button
                type="button"
                class="botonesfooter"
                id="btnvolvertendero"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor"
                    class="iconosbotones"
                    viewBox="0 0 16 16"
                >

                    <path
                        d="M9.05.435c-.58-.58-1.52-.58-2.1 0L.436 6.95c-.58.58-.58 1.519 0 2.098l6.516 6.516c.58.58 1.519.58 2.098 0l6.516-6.516c.58-.58.58-1.519 0-2.098zM7 8.466a.25.25 0 0 1-.41.192L4.23 6.692a.25.25 0 0 1 0-.384l2.36-1.966a.25.25 0 0 1 .41.192V6h1.5A2.5 2.5 0 0 1 11 8.5V11h-1V8.5A1.5 1.5 0 0 0 8.5 7H7z"
                    />

                </svg>

                VOLVER

            </button>


            <!-- BOTÓN FILTRAR -->
            <button
                type="button"
                class="botonesfooter"
                id="btnfiltrar"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor"
                    class="iconosbotones"
                    viewBox="0 0 16 16"
                >

                    <path
                        d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5"
                    />

                </svg>

                FILTRAR

            </button>

        </div>

    </div>

</body>

</html>