<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HISTORIAL DE VENTAS</title>
    <link rel="stylesheet" href="../ccs/fontawesome.css">
    <link rel="stylesheet" href="../ccs/historialtendero.css?v=1.7">
    <script type="module" src="../js/main.js?v=4.0"></script>
</head>
<body>

    <div class="contenedor">

        <div id="header">

            <div class="elemento">

                <span class="titulo-app">
                    APP DONDE EL VECI
                </span>
                <img src="../images/logo app.png" alt="logo" id="imagenlogo"> 

            </div>

        </div>


        <div class="contenido">

            <div class="filtros">

                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="date"
                        id="fechaInicio"
                    >

                    <label for="fechaInicio">
                        Desde
                    </label>

                </div>


                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="date"
                        id="fechaFin"
                    >

                    <label for="fechaFin">
                        Hasta
                    </label>

                </div>


                <div class="form-floating">

                    <input
                        class="casillasinfo"
                        type="text"
                        id="buscarUsuario"
                        placeholder="ID Usuario"
                    >

                    <label for="buscarUsuario">
                        ID Usuario
                    </label>

                </div>

            </div>


            <div class="listado">

                <table>

                    <thead>

                        <tr>
                            <th>FECHA</th>
                            <th>ID USUARIO</th>
                            <th>ESTADO</th>
                            <th>REVISAR</th>
                        </tr>

                    </thead>

                    <tbody id="tablaVentas">

                        <tr>
                            <td colspan="4">
                                Cargando historial...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        <div class="footer">

            <button
                type="button"
                class="botonesfooter"
                id="btnvolvertendero"
            >
                VOLVER
            </button>


            <button
                type="button"
                class="botonesfooter"
                id="btnfiltrar"
            >
                FILTRAR
            </button>

        </div>

    </div>


    <!-- DETALLE DE LA VENTA -->

    <dialog id="modalDetalleVenta">

        <div class="modal-contenido">

            <h2 class="modal-titulo">
                DETALLE DE LA VENTA
            </h2>


            <div class="info-venta">

                <p>
                    <strong>Venta No:</strong>
                    <span id="detalleIdVenta">-</span>
                </p>

                <p>
                    <strong>ID Cliente:</strong>
                    <span id="detalleCliente">-</span>
                </p>

                <p>
                    <strong>ID Tendero:</strong>
                    <span id="detalleTendero">-</span>
                </p>

                <p>
                    <strong>Fecha:</strong>
                    <span id="detalleFecha">-</span>
                </p>

                <p>
                    <strong>Fecha registro:</strong>
                    <span id="detalleFechaRegistro">-</span>
                </p>

                <p>
                    <strong>Estado:</strong>
                    <span id="detalleEstado">-</span>
                </p>

            </div>


            <div class="tabla-detalle-container">

                <table class="tabla-detalle">

                    <thead>

                        <tr>
                            <th>PRODUCTO</th>
                            <th>MARCA</th>
                            <th>MEDIDA</th>
                            <th>CANTIDAD</th>
                            <th>PRECIO</th>
                            <th>SUBTOTAL</th>
                        </tr>

                    </thead>

                    <tbody id="tablaDetalleVenta">

                        <tr>
                            <td colspan="6">
                                Cargando detalle...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>


            <div class="resumen-detalle">

                Productos diferentes:

                <strong>
                    <span id="detalleCantidadProductos">0</span>
                </strong>

                <br>

                Unidades vendidas:

                <strong>
                    <span id="detalleCantidadUnidades">0</span>
                </strong>

            </div>


            <div class="total-detalle">

                TOTAL VENTA:

                <span id="detalleTotal">
                    $0
                </span>

            </div>


            <div class="modal-botones">

                <button
                    type="button"
                    id="btnCerrarDetalle"
                >
                    CERRAR
                </button>

            </div>

        </div>

    </dialog>

</body>

</html>